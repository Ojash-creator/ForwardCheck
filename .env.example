# Copy this file to .env and fill it in:   cp .env.example .env
# NEVER commit .env (it is already in .gitignore).

# --- SerpApi (required for live checks) --------------------------------------
# Free account = 250 searches/month. Get your key: https://serpapi.com/manage-api-key
SERPAPI_API_KEY=your_serpapi_key_here

# --- Claude (optional) -------------------------------------------------------
# Better claim extraction for Hindi/Hinglish. Without it, a rule-based extractor is used.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# --- Behaviour ---------------------------------------------------------------
# auto  = live checks if SERPAPI_API_KEY is set, otherwise sample examples only
# true  = never call SerpApi (sample examples only, spends no credits)
DEMO_MODE=auto
# Safety valve so a bug or a loop can never burn through your monthly credits.
MAX_CREDITS_PER_SESSION=120
CACHE_DIR=.cache
